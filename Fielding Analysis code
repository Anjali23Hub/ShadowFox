# This code creates a bar chart to visualize the fielding performance scores of three Indian players from the 
# India vs Pakistan match on 9 June 2024. It assigns custom colors to each bar, adds labels for the axes and title, 
# and sets the y-axis limit to 20 for consistent scaling. Each bar displays its corresponding score above it. 
# Finally, the chart layout is adjusted for better spacing using 'tight_layout()', and the plot is displayed.

import matplotlib.pyplot as plt

players = ["Shivam Dube", "Arshdeep Singh", "Suryakumar Yadav"]
scores = [15, 12, 8]
colors = ['#4CAF50', '#2196F3', '#FFC107']

plt.figure(figsize=(8, 5))
bars = plt.bar(players, scores, color=colors, edgecolor='black')


plt.title('Fielding Performance Scores - India vs Pakistan (9 June 2024)', fontsize=14)
plt.xlabel('Player', fontsize=12)
plt.ylabel('Performance Score', fontsize=12)
plt.ylim(0, 20)


for bar in bars:
    yval = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2.0, yval + 0.3, int(yval), ha='center', va='bottom', fontsize=10)

plt.tight_layout()
plt.show()
